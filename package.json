  "type": "module",
  "license": "Apache-2.0",
  "author": "Hyper AI Lab",
  "homepage": "https://github.com/Hyper-AI-Lab/hyper-agents#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hyper-AI-Lab/hyper-agents.git"
  },
  "bugs": {
