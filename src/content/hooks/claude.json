{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [{ "type": "command", "command": "node", "args": ["{{SCRIPTS}}/hooks/session-start.mjs"], "timeout": 30 }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "node", "args": ["{{SCRIPTS}}/hooks/protect.mjs"], "timeout": 20, "onFailure": "block" }]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [{ "type": "command", "command": "node", "args": ["{{SCRIPTS}}/hooks/guard-shell.mjs"], "timeout": 20, "onFailure": "block" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "node", "args": ["{{SCRIPTS}}/hooks/post-edit.mjs"], "timeout": 300 }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "node", "args": ["{{SCRIPTS}}/hooks/stop-gate.mjs"], "timeout": 1800 }]
      }
    ]
  }
}
